---
// Las descargas (ADR 0033): una tarjeta por sistema, la del ordenador de quien
// visita primero y resaltada. Todo va en el HTML, con los enlaces y los tamaños
// de la última versión (release.ts, al compilar); el CSS enseña la
// arquitectura y la distribución elegidas (data-arquitectura y data-distro en
// <html>, de temprano.js y web.ts). Sin JavaScript se ven x64 y Ubuntu.
import { release } from "../datos/version";
import { type Fichero, megas } from "../datos/release";
import { textos } from "../i18n";
import { type Idioma, ruta } from "../i18n/rutas";
import Comando from "./Comando.astro";

interface Props {
  idioma: Idioma;
  /** Solo la tarjeta de un sistema (las páginas de descarga). */
  solo?: "macos" | "windows" | "linux";
  /** El título de la sección (en las páginas de descarga ya lo lleva la página). */
  cabeza?: boolean;
}
const { idioma, solo, cabeza = true } = Astro.props;
const ver = (s: "macos" | "windows" | "linux") => !solo || solo === s;
const t = textos(idioma);
const f = release.ficheros;
const id = idioma === "es" ? "descargas" : "downloads";
const marca = (x: Fichero) => `${x.sistema}|${x.arquitectura}|${x.formato}`;
const ARQ = [
  ["x64", "x64 · Intel / AMD"],
  ["arm64", "ARM"],
] as const;
const DISTROS = [
  ["ubuntu", "Ubuntu · Debian"],
  ["fedora", "Fedora · openSUSE"],
  ["arch", "Arch"],
  ["otra", t.descargas.otra],
] as const;
const icono = {
  macos:
    '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>',
  windows:
    '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="8.2" height="8.2" rx="1"/><rect x="12.8" y="3" width="8.2" height="8.2" rx="1"/><rect x="3" y="12.8" width="8.2" height="8.2" rx="1"/><rect x="12.8" y="12.8" width="8.2" height="8.2" rx="1"/></svg>',
  linux:
    '<svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6l5 5-5 5M12 18h8"/></svg>',
  flecha:
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v12M6 11l6 6 6-6M5 20h14"/></svg>',
};
const corta = (s: string) => `${s.slice(0, 16)}…`;
const appimage = (a: "x64" | "arm64") => f[`appimage-${a}`].nombre;
---

<section class="seccion" id={solo ? undefined : id} aria-labelledby={cabeza ? `${id}-titulo` : undefined} data-solo={solo}>
  <div class="envoltura">
    {
      cabeza && (
        <div class="cabeza" data-aparece>
          <span class="etiqueta">{t.descargas.etiqueta}</span>
          <h2 id={`${id}-titulo`}>{t.descargas.titulo}</h2>
          <p>{t.descargas.entrada}</p>
        </div>
      )
    }

    <div class="tarjetas" data-solo={solo}>
      {ver("macos") && (
      <article class="tarjeta" data-para="macos" data-sistema="macos">
        <span class="tuya">{t.descargas.tuya}</span>
        <header><span class="so" set:html={icono.macos} /><div><h3>macOS</h3><p class="req">{t.descargas.req.macos}</p>{!solo && <a class="mas" href={ruta("descargarMac", idioma)}>{t.descargas.mas}</a>}</div></header>
        <a class="boton descargar" href={f["dmg"].url} data-descarga={marca(f["dmg"])}>
          <Fragment set:html={icono.flecha} /><span>{t.descargas.boton.dmg}</span><small>{megas(f["dmg"].bytes, idioma)}</small>
        </a>
        <dl class="ficha">
          <dt>{t.descargas.version}</dt><dd>{release.version}</dd>
          <dt>{t.descargas.suma}</dt><dd><code title={f["dmg"].sha256}>{corta(f["dmg"].sha256)}</code></dd>
        </dl>
        <div class="grupo"><span class="titulo-grupo">{t.descargas.conBrew}</span><Comando idioma={idioma} nombre="brew" lineas={["brew install --cask webcafeina/apolo/apolo"]} /></div>
        <details class="otras">
          <summary>{t.descargas.otras}</summary>
          <ul>
            <li><a href={f["cli-macos"].url} data-descarga={marca(f["cli-macos"])}>{t.descargas.cli}</a> · {megas(f["cli-macos"].bytes, idioma)}</li>
            <li><a href={f["mcpb-macos"].url} data-descarga={marca(f["mcpb-macos"])}>{t.descargas.mcpb}</a> · {megas(f["mcpb-macos"].bytes, idioma)}</li>
          </ul>
        </details>
        <p class="primera">{t.descargas.primera.macos}</p>
      </article>
      )}

      {ver("windows") && (
      <article class="tarjeta" data-para="windows" data-sistema="windows">
        <span class="tuya">{t.descargas.tuya}</span>
        <header><span class="so" set:html={icono.windows} /><div><h3>Windows</h3><p class="req">{t.descargas.req.windows}</p>{!solo && <a class="mas" href={ruta("descargarWindows", idioma)}>{t.descargas.mas}</a>}</div></header>
        <div class="grupo">
          <span class="titulo-grupo" id={`${id}-arq-win`}>{t.descargas.procesador}</span>
          <div class="opciones" role="radiogroup" aria-labelledby={`${id}-arq-win`} data-elige="arquitectura">
            {ARQ.map(([v, n]) => <button type="button" role="radio" data-valor={v}>{n}</button>)}
          </div>
          <p class="nota-arm">{t.descargas.windowsArm}</p>
        </div>
        {
          ARQ.map(([a]) => (
            <div class="por-arq" data-arq={a}>
              <a class="boton descargar" href={f[`exe-${a}`].url} data-descarga={marca(f[`exe-${a}`])}>
                <Fragment set:html={icono.flecha} /><span>{t.descargas.boton.exe}</span><small>{megas(f[`exe-${a}`].bytes, idioma)}</small>
              </a>
              <dl class="ficha">
                <dt>{t.descargas.version}</dt><dd>{release.version}</dd>
                <dt>{t.descargas.suma}</dt><dd><code title={f[`exe-${a}`].sha256}>{corta(f[`exe-${a}`].sha256)}</code></dd>
              </dl>
              <details class="otras">
                <summary>{t.descargas.otras}</summary>
                <ul>
                  <li><a href={f[`cli-windows-${a}`].url} data-descarga={marca(f[`cli-windows-${a}`])}>{t.descargas.cli}</a> · {megas(f[`cli-windows-${a}`].bytes, idioma)}</li>
                  <li><a href={f[`mcpb-windows-${a}`].url} data-descarga={marca(f[`mcpb-windows-${a}`])}>{t.descargas.mcpb}</a> · {megas(f[`mcpb-windows-${a}`].bytes, idioma)}</li>
                </ul>
              </details>
            </div>
          ))
        }
        <p class="primera">{t.descargas.primera.windows}</p>
      </article>
      )}

      {ver("linux") && (
      <article class="tarjeta" data-para="linux" data-sistema="linux" id="linux">
        <span class="tuya">{t.descargas.tuya}</span>
        <header><span class="so" set:html={icono.linux} /><div><h3>Linux</h3><p class="req">{t.descargas.req.linux}</p>{!solo && <a class="mas" href={ruta("descargarLinux", idioma)}>{t.descargas.mas}</a>}</div></header>
        <div class="grupo">
          <span class="titulo-grupo" id={`${id}-distro`}>{t.descargas.distribucion}</span>
          <div class="opciones" role="radiogroup" aria-labelledby={`${id}-distro`} data-elige="distro">
            {DISTROS.map(([v, n]) => <button type="button" role="radio" data-valor={v}>{n}</button>)}
          </div>
        </div>
        <div class="grupo sin-arch">
          <span class="titulo-grupo" id={`${id}-arq-linux`}>{t.descargas.procesador}</span>
          <div class="opciones" role="radiogroup" aria-labelledby={`${id}-arq-linux`} data-elige="arquitectura">
            {ARQ.map(([v, n]) => <button type="button" role="radio" data-valor={v}>{n}</button>)}
          </div>
        </div>

        <div class="por-distro" data-distro="ubuntu">
          {ARQ.map(([a]) => (
            <a class="boton descargar por-arq" data-arq={a} href={f[`deb-${a}`].url} data-descarga={marca(f[`deb-${a}`])}>
              <Fragment set:html={icono.flecha} /><span>{t.descargas.boton.deb}</span><small>{megas(f[`deb-${a}`].bytes, idioma)}</small>
            </a>
          ))}
          <div class="grupo"><span class="titulo-grupo">{t.descargas.conRepositorio}</span>
            <Comando idioma={idioma} nombre="apt" lineas={[
              "sudo install -dm755 /etc/apt/keyrings",
              "sudo curl -fsSLo /etc/apt/keyrings/apolo.asc https://apolo.webcafeina.com/apolo.asc",
              "sudo curl -fsSLo /etc/apt/sources.list.d/apolo.sources https://apolo.webcafeina.com/apt/apolo.sources",
              "sudo apt update && sudo apt install apolo",
            ]} />
          </div>
        </div>
        <div class="por-distro" data-distro="fedora">
          {ARQ.map(([a]) => (
            <a class="boton descargar por-arq" data-arq={a} href={f[`rpm-${a}`].url} data-descarga={marca(f[`rpm-${a}`])}>
              <Fragment set:html={icono.flecha} /><span>{t.descargas.boton.rpm}</span><small>{megas(f[`rpm-${a}`].bytes, idioma)}</small>
            </a>
          ))}
          <div class="grupo"><span class="titulo-grupo">{t.descargas.conRepositorio}</span>
            <Comando idioma={idioma} nombre="dnf" lineas={["sudo curl -fsSLo /etc/yum.repos.d/apolo.repo https://apolo.webcafeina.com/rpm/apolo.repo", "sudo dnf install apolo"]} />
            <Comando idioma={idioma} nombre="zypper" lineas={["sudo zypper addrepo https://apolo.webcafeina.com/rpm/apolo.repo", "sudo zypper install apolo"]} />
          </div>
        </div>
        <div class="por-distro" data-distro="arch">
          <a class="boton descargar" href="/aur/PKGBUILD" data-descarga="linux|any|pkgbuild">
            <Fragment set:html={icono.flecha} /><span>{t.descargas.boton.pkgbuild}</span>
          </a>
          <Comando idioma={idioma} nombre="makepkg" lineas={["mkdir apolo && cd apolo", "curl -fsSLO https://apolo.webcafeina.com/aur/PKGBUILD", "makepkg -si"]} />
          <p class="primera">{t.descargas.pronto}</p>
        </div>
        <div class="por-distro" data-distro="otra">
          {ARQ.map(([a]) => (
            <div class="por-arq" data-arq={a}>
              <a class="boton descargar" href={f[`appimage-${a}`].url} data-descarga={marca(f[`appimage-${a}`])}>
                <Fragment set:html={icono.flecha} /><span>{t.descargas.boton.appimage}</span><small>{megas(f[`appimage-${a}`].bytes, idioma)}</small>
              </a>
              <Comando idioma={idioma} nombre="appimage" lineas={[`chmod +x ${appimage(a)}`, `./${appimage(a)}`]} />
            </div>
          ))}
        </div>

        {ARQ.map(([a]) => (
          <div class="por-arq" data-arq={a}>
          <details class="otras">
            <summary>{t.descargas.otras}</summary>
            <ul>
              {(["deb", "rpm", "appimage"] as const).map((x) => (
                <li><a href={f[`${x}-${a}`].url} data-descarga={marca(f[`${x}-${a}`])}>{f[`${x}-${a}`].nombre}</a> · {megas(f[`${x}-${a}`].bytes, idioma)}</li>
              ))}
              <li><a href={f[`cli-linux-${a}`].url} data-descarga={marca(f[`cli-linux-${a}`])}>{t.descargas.cli}</a> · {megas(f[`cli-linux-${a}`].bytes, idioma)}</li>
              <li><a href={f[`mcpb-linux-${a}`].url} data-descarga={marca(f[`mcpb-linux-${a}`])}>{t.descargas.mcpb}</a> · {megas(f[`mcpb-linux-${a}`].bytes, idioma)}</li>
            </ul>
          </details>
          </div>
        ))}
        <p class="primera">{t.descargas.primera.linux}</p>
      </article>
      )}
    </div>
  </div>
</section>

<style>
  .seccion {
    padding-block: clamp(72px, 10vw, 128px);
  }
  .cabeza {
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 760px;
    margin: 0 auto 48px;
    text-align: center;
  }
  h2 {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.04;
  }
  [data-solo] {
    padding-block: 0 24px;
  }
  .tarjetas[data-solo] {
    max-width: 560px;
    margin-inline: auto;
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 330px), 1fr));
    gap: 20px;
    align-items: start;
  }
  .tarjeta {
    position: relative;
    display: grid;
    gap: 16px;
    min-width: 0;
    padding: 28px;
    border-radius: var(--radio);
    background: var(--suave);
  }
  header {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .so {
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    background: var(--lienzo);
    color: var(--tinta);
  }
  h3 {
    font-size: 24px;
    letter-spacing: -0.02em;
  }
  .req {
    font-size: 14px;
    color: var(--apagado);
  }
  .mas {
    font-size: 14px;
    color: var(--tinta);
    text-underline-offset: 3px;
  }
  .descargar {
    width: 100%;
    justify-content: flex-start;
  }
  .descargar span {
    flex: 1;
    text-align: left;
  }
  .descargar small {
    white-space: nowrap;
  }
  /* El botón, con la forma de cada sistema. */
  [data-sistema="windows"] .descargar {
    border-radius: 6px;
  }
  [data-sistema="linux"] .descargar {
    border-radius: 10px;
  }
  .grupo {
    display: grid;
    gap: 8px;
    min-width: 0;
  }
  .titulo-grupo {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--apagado);
  }
  .opciones {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .opciones button {
    border: 1px solid var(--filete);
    background: var(--lienzo);
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 13px;
    cursor: pointer;
    color: var(--cuerpo);
  }
  .opciones button[aria-checked="true"] {
    border-color: var(--tinta);
    background: var(--tinta);
    color: var(--lienzo);
    font-weight: 600;
  }
  .ficha {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 14px;
    margin: 0;
    font-size: 13px;
    color: var(--apagado);
    font-variant-numeric: tabular-nums;
  }
  .ficha dd {
    margin: 0;
    color: var(--cuerpo);
    min-width: 0;
  }
  .ficha code {
    font-size: 12px;
  }
  .por-arq,
  .por-distro {
    display: none;
    gap: 14px;
  }
  .otras summary {
    cursor: pointer;
    font-size: 14px;
    color: var(--cuerpo);
  }
  .otras ul {
    margin: 10px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 4px;
    font-size: 14px;
    overflow-wrap: anywhere;
  }
  .primera,
  .nota-arm {
    font-size: 13px;
    color: var(--apagado);
  }
  .nota-arm {
    display: none;
  }
  .tuya {
    display: none;
    position: absolute;
    top: -12px;
    left: 24px;
    padding: 3px 11px;
    border-radius: 999px;
    background: var(--relleno);
    color: var(--sobre-acento);
    font-size: 12px;
    font-weight: 700;
  }

  /* La arquitectura (x64 salvo que se elija ARM) y la distribución (Ubuntu si no hay otra). */
  :global(html:not([data-arquitectura="arm64"])) .por-arq[data-arq="x64"],
  :global(html[data-arquitectura="arm64"]) .por-arq[data-arq="arm64"],
  :global(html:not([data-distro])) .por-distro[data-distro="ubuntu"],
  :global(html[data-distro="ubuntu"]) .por-distro[data-distro="ubuntu"],
  :global(html[data-distro="fedora"]) .por-distro[data-distro="fedora"],
  :global(html[data-distro="arch"]) .por-distro[data-distro="arch"],
  :global(html[data-distro="otra"]) .por-distro[data-distro="otra"] {
    display: grid;
  }
  :global(html:not([data-arquitectura="arm64"])) a.por-arq[data-arq="x64"],
  :global(html[data-arquitectura="arm64"]) a.por-arq[data-arq="arm64"] {
    display: inline-flex;
  }
  :global(html[data-distro="arch"]) .sin-arch {
    display: none;
  }
  /* En Windows, si la arquitectura es una suposición (Firefox en ARM no la dice). */
  :global(html[data-plataforma="windows"]:not([data-arquitectura-segura])) .nota-arm {
    display: block;
  }
  /* La tarjeta del ordenador de quien visita, primero y resaltada. */
  :global(html[data-plataforma="macos"]) .tarjeta[data-para="macos"],
  :global(html[data-plataforma="windows"]) .tarjeta[data-para="windows"],
  :global(html[data-plataforma="linux"]) .tarjeta[data-para="linux"] {
    order: -1;
    box-shadow: 0 0 0 2px var(--relleno), 0 28px 60px -34px rgb(0 0 0 / 0.45);
  }
  :global(html[data-plataforma="macos"]) .tarjeta[data-para="macos"] .tuya,
  :global(html[data-plataforma="windows"]) .tarjeta[data-para="windows"] .tuya,
  :global(html[data-plataforma="linux"]) .tarjeta[data-para="linux"] .tuya {
    display: block;
  }
</style>
