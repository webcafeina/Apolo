---
// «En tu sistema» (ADR 0033): Apolo en macOS, Windows, GNOME y KDE, en cuatro
// pantallas. Todas van en el HTML; la vista sale de data-vista en <html> (lo
// detectado o lo elegido, temprano.js) y la pantalla de data-pantalla en la
// sección (web.ts). Las ocultas llevan loading="lazy" y no se descargan.
import capturas from "../datos/capturas.json";
import { textos } from "../i18n";
import type { Idioma } from "../i18n/rutas";
import Ventana from "./Ventana.astro";

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);
const VISTAS = ["macos", "windows", "gnome", "kde"] as const;
const PANTALLAS = ["estudio", "diferencias", "lotes", "agentes"] as const;
const id = idioma === "es" ? "sistema" : "system";
const src = (vista: string, pantalla: string, tema: string) =>
  `/img/${vista}/${idioma === "es" ? "" : "en/"}${pantalla}-${tema}.webp`;
---

<section class="seccion" id={id} data-pantalla="estudio" aria-labelledby={`${id}-titulo`}>
  <div class="envoltura">
    <div class="cabeza" data-aparece>
      <span class="etiqueta">{t.sistema.etiqueta}</span>
      <h2 id={`${id}-titulo`}>{t.sistema.titulo}</h2>
      <p>{t.sistema.entrada}</p>
    </div>
    <div class="selectores">
      <div class="pestanas" role="radiogroup" aria-label={t.sistema.verEn} data-elige="vista">
        {VISTAS.map((v) => <button type="button" role="radio" data-valor={v}>{t.sistema.vistas[v]}</button>)}
      </div>
      <div class="pestanas" role="radiogroup" aria-label={t.sistema.pantalla} data-elige="pantalla">
        {PANTALLAS.map((p) => <button type="button" role="radio" data-valor={p}>{t.sistema.pantallas[p]}</button>)}
      </div>
    </div>
    <div class="vistas" data-aparece>
      {
        VISTAS.map((v) => (
          <div class="vista" data-vista={v}>
            <Ventana vista={v}>
              {PANTALLAS.map((p) => {
                const m = capturas.vistas[v][p][idioma];
                return (
                  <picture class="pantalla" data-pantalla={p}>
                    <source media="(prefers-color-scheme: dark)" srcset={src(v, p, "oscuro")} />
                    <img
                      src={src(v, p, "claro")}
                      width={m.ancho}
                      height={m.alto}
                      loading="lazy"
                      alt={t.sistema.alt.replace("{vista}", t.sistema.vistas[v]).replace("{pantalla}", t.sistema.pantallas[p])}
                    />
                  </picture>
                );
              })}
            </Ventana>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .seccion {
    padding-block: clamp(72px, 10vw, 128px);
  }
  .cabeza {
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 760px;
    margin: 0 auto 36px;
    text-align: center;
  }
  h2 {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.04;
  }
  .cabeza p {
    font-size: 19px;
  }
  .selectores {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px 18px;
    margin-bottom: 28px;
  }
  .pestanas {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 3px;
    border-radius: 999px;
    background: var(--elevada);
  }
  .pestanas button {
    border: 0;
    background: transparent;
    padding: 7px 15px;
    border-radius: 999px;
    font-size: 14px;
    cursor: pointer;
    color: var(--cuerpo);
  }
  .pestanas button[aria-checked="true"] {
    background: var(--lienzo);
    color: var(--tinta);
    font-weight: 600;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.14);
  }
  .vista,
  .pantalla {
    display: none;
  }
  /* La vista de <html> (sin ella, macOS) y la pantalla de la sección. */
  :global(html:not([data-vista])) .vista[data-vista="macos"],
  :global(html[data-vista="macos"]) .vista[data-vista="macos"],
  :global(html[data-vista="windows"]) .vista[data-vista="windows"],
  :global(html[data-vista="gnome"]) .vista[data-vista="gnome"],
  :global(html[data-vista="kde"]) .vista[data-vista="kde"],
  [data-pantalla="estudio"] .pantalla[data-pantalla="estudio"],
  [data-pantalla="diferencias"] .pantalla[data-pantalla="diferencias"],
  [data-pantalla="lotes"] .pantalla[data-pantalla="lotes"],
  [data-pantalla="agentes"] .pantalla[data-pantalla="agentes"] {
    display: block;
  }
</style>
