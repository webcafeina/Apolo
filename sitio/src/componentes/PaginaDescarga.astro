---
// Una página de descarga (ADR 0033): Apolo en ese sistema, su tarjeta de
// descarga, cómo se instala y se actualiza, y sus requisitos.
import { DESCARGAR, type Sistema } from "../contenido/descargar";
import type { Idioma, Pagina as P } from "../i18n/rutas";
import Pagina from "../layouts/Pagina.astro";
import Captura from "./Captura.astro";
import Comprobar from "./Comprobar.astro";
import Descargas from "./Descargas.astro";
import Secciones from "./Secciones.astro";
import Ventana from "./Ventana.astro";

interface Props {
  idioma: Idioma;
  sistema: Sistema;
}
const { idioma, sistema } = Astro.props;
const c = DESCARGAR[idioma][sistema];
const pagina: P = { macos: "descargarMac", windows: "descargarWindows", linux: "descargarLinux" }[sistema] as P;
const vista = sistema === "linux" ? "gnome" : sistema;
---

<Pagina idioma={idioma} pagina={pagina} titulo={c.titulo} descripcion={c.descripcion} etiqueta={c.etiqueta} h1={c.h1} entrada={c.entrada}>
  <Fragment slot="antes">
    <Descargas idioma={idioma} solo={sistema} cabeza={false} />
    <div class="envoltura captura">
      <Ventana vista={vista}><Captura idioma={idioma} vista={vista} pantalla="estudio" /></Ventana>
    </div>
  </Fragment>
  <Secciones idioma={idioma} secciones={c.secciones} />
  <Comprobar idioma={idioma} sistema={sistema} />
</Pagina>

<style>
  .captura {
    max-width: 1080px;
    margin-top: 24px;
  }
</style>
