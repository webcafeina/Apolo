---
// El índice de las guías o de las comparativas (ADR 0034): una tarjeta por
// cada una, con su resumen, y un enlace al otro índice.
import type { Articulo } from "../contenido/articulos";
import { INDICE } from "../contenido/comparativas";
import { textos } from "../i18n";
import { type Idioma, ruta } from "../i18n/rutas";
import Pagina from "../layouts/Pagina.astro";

interface Props {
  idioma: Idioma;
  cual: "guias" | "comparativas";
  articulos: Articulo[];
}
const { idioma, cual, articulos } = Astro.props;
const t = textos(idioma).articulos;
const cabeza = (x: typeof cual) => (x === "guias" ? t.guias : INDICE[idioma]);
const c = cabeza(cual);
const otro = cual === "guias" ? "comparativas" : "guias";
---

<Pagina idioma={idioma} pagina={cual} titulo={c.titulo} descripcion={c.descripcion} etiqueta={c.etiqueta} h1={c.h1} entrada={c.entrada}>
  <ul class="indice">
    {
      articulos.map((a) => (
        <li>
          <a href={ruta(a.pagina, idioma)}>
            <h2>{a.h1.replace(/\.$/, "")}</h2>
            <p>{a.resumen}</p>
            <span class="leer">{t.leer} →</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="otro"><a href={ruta(otro, idioma)}>{cabeza(otro).h1.replace(/\.$/, "")} →</a></p>
</Pagina>

<style>
  .indice {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 14px;
  }
  .indice a {
    display: grid;
    gap: 6px;
    padding: 20px 22px;
    border-radius: 18px;
    background: var(--suave);
    box-shadow: 0 0 0 1px var(--filete);
    color: inherit;
    text-decoration: none;
  }
  .indice a:hover,
  .indice a:focus-visible {
    box-shadow: 0 0 0 2px var(--oro-trazo);
  }
  .indice h2 {
    margin: 0;
    font-size: 22px;
  }
  .indice p {
    margin: 0;
  }
  .leer {
    font-weight: 600;
    color: var(--oro-texto);
  }
  .otro {
    margin-top: 28px;
    font-weight: 600;
  }
</style>
