{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apolo",
  "mainBinaryName": "apolo-app",
  "identifier": "com.webcafeina.apolo",
  "build": {
    "beforeDevCommand": "pnpm -C frontend dev",
    "beforeBuildCommand": "pnpm -C frontend build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "Apolo",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost apolo: http://apolo.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Optimiza imágenes con los motores de Squoosh",
    "longDescription": "Apolo comprime imágenes a WebP, AVIF, JPEG XL, MozJPEG y PNG con los mismos motores que Squoosh y cwebp, viendo el resultado al momento.",
    "copyright": "© 2026 Webcafeína · GPLv3",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
