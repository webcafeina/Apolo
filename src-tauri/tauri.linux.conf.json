{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "Apolo",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "create": false
      }
    ]
  },
  "bundle": {
    "shortDescription": "Optimiza fotos: pesan menos y se ven igual",
    "longDescription": "Apolo convierte fotos a WebP, AVIF, JPEG XL, MozJPEG y PNG con los mismos motores que cwebp, viendo el resultado al momento.",
    "linux": {
      "deb": {
        "desktopTemplate": "../empaquetado/linux/apolo.desktop",
        "files": {
          "/usr/share/metainfo/com.webcafeina.apolo.metainfo.xml": "../empaquetado/linux/com.webcafeina.apolo.metainfo.xml"
        }
      },
      "rpm": {
        "release": "1",
        "depends": ["webkit2gtk4.1", "gtk3"],
        "desktopTemplate": "../empaquetado/linux/apolo.desktop",
        "files": {
          "/usr/share/metainfo/com.webcafeina.apolo.metainfo.xml": "../empaquetado/linux/com.webcafeina.apolo.metainfo.xml"
        }
      }
    }
  }
}
