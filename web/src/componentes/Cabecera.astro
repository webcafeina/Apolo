---
// La cabecera (ADR 0033): la marca, las secciones, ESP / ENG con el activo en
// negrita (lleva a la misma página en el otro idioma) y Descargar. Hasta 820 px,
// las secciones y el idioma pasan al menú; el botón de Descargar se queda fuera.
import { textos } from "../i18n";
import { navegacion } from "../i18n/navegacion";
import { type Idioma, type Pagina, ruta } from "../i18n/rutas";

interface Props {
  idioma: Idioma;
  pagina: Pagina;
}
const { idioma, pagina } = Astro.props;
const t = textos(idioma);
const n = navegacion(idioma);
const inicio = ruta("inicio", idioma);
const ancla = (id: string) => (pagina === "inicio" ? `#${id}` : `${inicio}#${id}`);
const descargas = idioma === "es" ? "descargas" : "downloads";
const todas = { href: ancla(descargas), texto: t.nav.todas };
const GRUPOS = [
  { titulo: n.descargas.titulo, enlaces: [...n.descargas.enlaces, todas] },
  n.usar,
  n.aprender,
];
---

<header class="cabecera">
  <div class="envoltura">
    <a class="logo" href={inicio}>
      <img src="/icono.png" alt="" width="28" height="28" />
      <span>Apolo</span>
    </a>
    <nav class="nav" aria-label={t.nav.etiqueta}>
      {
        GRUPOS.map((g) => (
          <details class="desplegable" data-menu>
            <summary>{g.titulo}</summary>
            <div class="panel">{g.enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}</div>
          </details>
        ))
      }
      <a href={n.novedades.href}>{n.novedades.texto}</a>
    </nav>
    <div class="derecha">
      <nav class="idioma" aria-label={t.idioma.etiqueta}>
        <a href={ruta(pagina, "es")} lang="es" hreflang="es" aria-label={t.idioma.es} aria-current={idioma === "es" ? "page" : undefined}>ESP</a>
        <span aria-hidden="true">/</span>
        <a href={ruta(pagina, "en")} lang="en" hreflang="en" aria-label={t.idioma.en} aria-current={idioma === "en" ? "page" : undefined}>ENG</a>
      </nav>
      <a class="boton boton-cabecera" href={ancla(descargas)}>{t.nav.descargar}</a>
      <details class="menu-movil" data-menu>
        <summary aria-label={t.nav.menu}>
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <nav class="panel-movil" aria-label={t.nav.menu}>
          {
            GRUPOS.map((g) => (
              <div class="grupo">
                <p>{g.titulo}</p>
                {g.enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}
              </div>
            ))
          }
          <div class="grupo"><a class="suelto" href={n.novedades.href}>{n.novedades.texto}</a></div>
          <div class="idioma-movil" role="group" aria-label={t.idioma.etiqueta}>
            <a href={ruta(pagina, "es")} lang="es" hreflang="es" aria-label={t.idioma.es} aria-current={idioma === "es" ? "page" : undefined}>ESP</a>
            <span aria-hidden="true">/</span>
            <a href={ruta(pagina, "en")} lang="en" hreflang="en" aria-label={t.idioma.en} aria-current={idioma === "en" ? "page" : undefined}>ENG</a>
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 40;
    padding-top: env(safe-area-inset-top, 0px);
    background: color-mix(in srgb, var(--lienzo) 82%, transparent);
    backdrop-filter: saturate(1.8) blur(20px);
    -webkit-backdrop-filter: saturate(1.8) blur(20px);
    border-bottom: 1px solid color-mix(in srgb, var(--filete) 70%, transparent);
  }
  /* Con un menú abierto, por encima del aviso de cookies (z-index 60), que si no tapa medio menú en el
     móvil la primera vez. Al cerrarlo, el aviso vuelve a verse. */
  .cabecera:has(details[data-menu][open]) {
    z-index: 70;
  }
  .envoltura {
    display: flex;
    align-items: center;
    gap: 28px;
    min-height: var(--alto-cabecera);
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--tinta);
  }
  .logo img {
    width: 28px;
    height: 28px;
    border-radius: 7px;
  }
  .logo span {
    font-family: var(--marca);
    font-size: 22px;
  }
  .nav {
    display: flex;
    gap: 24px;
    font-size: 14px;
  }
  .nav {
    align-items: center;
  }
  .nav a,
  .nav summary {
    color: var(--cuerpo);
    text-decoration: none;
  }
  .nav a:hover,
  .nav summary:hover,
  .desplegable[open] summary {
    color: var(--tinta);
  }
  summary {
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .desplegable {
    position: relative;
  }
  .desplegable summary {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .desplegable summary::after {
    content: "";
    width: 6px;
    height: 6px;
    margin-top: -3px;
    border-right: 1.6px solid currentColor;
    border-bottom: 1.6px solid currentColor;
    transform: rotate(45deg);
  }
  .desplegable[open] summary::after {
    margin-top: 3px;
    transform: rotate(225deg);
  }
  .panel {
    position: absolute;
    top: calc(100% + 12px);
    left: -14px;
    min-width: 210px;
    display: grid;
    gap: 2px;
    padding: 8px;
    border: 1px solid var(--filete);
    border-radius: 14px;
    background: var(--lienzo);
    box-shadow: 0 14px 40px rgb(0 0 0 / 0.14);
  }
  .panel a {
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--tinta);
  }
  .panel a:hover {
    background: var(--suave);
  }
  .menu-movil {
    display: none;
  }
  .menu-movil summary {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--tinta);
  }
  .menu-movil[open] summary {
    background: var(--suave);
  }
  .panel-movil {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100dvh - var(--alto-cabecera));
    overflow-y: auto;
    overscroll-behavior: contain;
    display: grid;
    gap: 22px;
    padding: 22px max(20px, env(safe-area-inset-right, 0px)) 28px max(20px, env(safe-area-inset-left, 0px));
    border-bottom: 1px solid var(--filete);
    background: var(--lienzo);
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.14);
  }
  .grupo {
    display: grid;
    gap: 2px;
  }
  .grupo p,
  .grupo a.suelto {
    margin: 0 0 2px;
    padding: 0;
    font-size: 20px;
    font-weight: 800;
    color: var(--tinta);
  }
  .grupo a {
    padding: 8px 0;
    font-size: 16px;
    color: var(--cuerpo);
    text-decoration: none;
  }
  /* El idioma, como en el ordenador: una pastilla, para que no parezca una entrada más del menú. */
  .idioma-movil {
    justify-self: start;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 14px;
    border-radius: 999px;
    background: var(--suave);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--apagado);
  }
  .idioma-movil a {
    padding: 8px 4px;
    color: var(--apagado);
    text-decoration: none;
  }
  .idioma-movil a[aria-current="page"] {
    color: var(--tinta);
    font-weight: 800;
  }
  .derecha {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .idioma {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--apagado);
  }
  .idioma a {
    padding: 6px 2px;
    color: var(--apagado);
    text-decoration: none;
  }
  .idioma a[aria-current="page"] {
    color: var(--tinta);
    font-weight: 800;
  }
  .boton-cabecera {
    min-height: 34px;
    padding: 6px 16px;
    font-size: 14px;
  }
  @media (max-width: 820px) {
    .nav {
      display: none;
    }
    .menu-movil {
      display: block;
    }
    .idioma {
      display: none;
    }
    .derecha {
      gap: 12px;
    }
  }
</style>
