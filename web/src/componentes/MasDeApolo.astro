---
// Las demás páginas de la web, en la portada: lo que antes casi solo se encontraba en el pie.
import { release } from "../datos/version";
import { textos } from "../i18n";
import { type Idioma, type Pagina, ruta } from "../i18n/rutas";

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma).masDeApolo;
const id = idioma === "es" ? "mas-de-apolo" : "more-of-apolo";
const TARJETAS: { pagina: Pagina; clave: keyof typeof t.tarjetas; icono: string }[] = [
  { pagina: "agentes", clave: "agentes", icono: '<path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.500 9.500l4.7-1.8zM19 15l.9 2.1L22 18l-2.1.9L19 21l-.9-2.1L16 18l2.1-.9z"/>' },
  { pagina: "cli", clave: "cli", icono: '<path d="M4 7l5 5-5 5M12 18h8"/>' },
  { pagina: "guias", clave: "guias", icono: '<path d="M5 4h11a3 3 0 0 1 3 3v13H8a3 3 0 0 1-3-3zM5 17a3 3 0 0 1 3-3h11"/>' },
  { pagina: "comparativas", clave: "comparativas", icono: '<path d="M12 4v16M8 20h8M5 7h14M5 7l-3 7a3 3 0 0 0 6 0zM19 7l-3 7a3 3 0 0 0 6 0z"/>' },
  { pagina: "preguntas", clave: "preguntas", icono: '<circle cx="12" cy="12" r="9"/><path d="M9.500 9.500a2.500 2.500 0 1 1 3.600 2.300c-.800.400-1.100.900-1.100 1.700M12 17h.01"/>' },
  { pagina: "novedades", clave: "novedades", icono: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3M5.600 5.600l2.100 2.100M16.300 16.300l2.100 2.100M18.400 5.600l-2.100 2.100M7.700 16.300l-2.100 2.100"/><circle cx="12" cy="12" r="3.500"/>' },
];
---

<section class="seccion" id={id} aria-labelledby={`${id}-titulo`}>
  <div class="envoltura">
    <div class="cabeza" data-aparece>
      <span class="etiqueta">{t.etiqueta}</span>
      <h2 id={`${id}-titulo`}>{t.titulo}</h2>
    </div>
    <ul class="rejilla">
      {
        TARJETAS.map(({ pagina, clave, icono }) => (
          <li data-aparece>
            <a class="tarjeta-enlace" href={ruta(pagina, idioma)}>
              <span class="icono" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icono} />
              </span>
              <h3>{t.tarjetas[clave].titulo}</h3>
              <p>{t.tarjetas[clave].texto.replace("{version}", release.version)}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .seccion {
    padding-block: clamp(72px, 10vw, 128px);
    background: var(--lienzo);
  }
  .cabeza {
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 760px;
    margin: 0 auto 48px;
    text-align: center;
  }
  h2 {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.04;
  }
  .rejilla {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 18px;
  }
  .rejilla li {
    display: grid;
  }
  .tarjeta-enlace {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: 28px;
    border-radius: var(--radio);
    background: var(--suave);
    color: var(--tinta);
    text-decoration: none;
    transition: transform 0.18s ease;
  }
  .tarjeta-enlace:hover {
    transform: translateY(-2px);
  }
  .tarjeta-enlace:hover h3 {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .tarjeta-enlace p {
    color: var(--cuerpo);
  }
  .icono {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: var(--relleno-tenue);
    color: var(--oro-trazo);
  }
  h3 {
    font-size: 22px;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  @media (prefers-reduced-motion: reduce) {
    .tarjeta-enlace {
      transition: none;
    }
    .tarjeta-enlace:hover {
      transform: none;
    }
  }
</style>
