---
// Una guía o una comparativa (ADR 0034): sus secciones, la fecha, las páginas
// relacionadas, la descarga al final y sus datos estructurados (TechArticle).
import { type Articulo, dia } from "../contenido/articulos";
import { AGENTES, CLI } from "../contenido/cli-agentes";
import { COMPARATIVAS } from "../contenido/comparativas";
import { GUIAS } from "../contenido/guias";
import { textos } from "../i18n";
import { type Idioma, ruta } from "../i18n/rutas";
import Pagina from "../layouts/Pagina.astro";
import JsonLd from "./JsonLd.astro";
import Secciones from "./Secciones.astro";

interface Props {
  idioma: Idioma;
  a: Articulo;
}
const { idioma, a } = Astro.props;
const t = textos(idioma).articulos;
const todos = [...GUIAS[idioma], ...COMPARATIVAS[idioma]];
// Una guía o comparativa, o una de las páginas de la CLI y de agentes, con su título y su resumen.
const relacionada = (p: string) => {
  const a = todos.find((x) => x.pagina === p);
  if (a) return { h1: a.h1, resumen: a.resumen };
  const c = p === "agentes" ? AGENTES[idioma] : p === "cli" ? CLI[idioma] : undefined;
  return c && { h1: c.h1, resumen: c.descripcion };
};
const fecha = (d: string) => dia(d, idioma);
const url = new URL(ruta(a.pagina, idioma), Astro.site).href;
const datos = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "@id": `${url}#articulo`,
  headline: a.h1.replace(/\.$/, ""),
  description: a.descripcion,
  inLanguage: idioma,
  datePublished: a.publicado,
  dateModified: a.revisado,
  mainEntityOfPage: { "@id": `${url}#pagina` },
  author: { "@id": "https://webcafeina.com/#organizacion" },
  publisher: { "@id": "https://webcafeina.com/#organizacion" },
  about: { "@id": new URL("/#apolo", Astro.site).href },
  image: new URL(`/social/apolo-${idioma}.png`, Astro.site).href,
};
---

<Pagina idioma={idioma} pagina={a.pagina} titulo={a.titulo} descripcion={a.descripcion} etiqueta={a.etiqueta} h1={a.h1} entrada={a.entrada}>
  <Fragment slot="cabeza">
    {
      a.rival ? (
        <div class="versus" aria-hidden="true">
          <span class="lado apolo"><img src="/icono.png" alt="" width="28" height="28" />Apolo</span>
          <span class="vs">{idioma === "es" ? "frente a" : "vs"}</span>
          <span class="lado">{a.rival}</span>
        </div>
      ) : (
        <div class="destacado">
          <strong>{a.destacado.valor}</strong>
          <span>{a.destacado.texto}</span>
        </div>
      )
    }
  </Fragment>
  <JsonLd datos={datos} />
  <p class="fecha">
    {t.publicado} <time datetime={a.publicado}>{fecha(a.publicado)}</time>{
      a.revisado !== a.publicado && (
        <>
          , {t.revisado} <time datetime={a.revisado}>{fecha(a.revisado)}</time>
        </>
      )
    }
  </p>
  <Secciones idioma={idioma} secciones={a.secciones} />
  <aside class="final">
    <p><strong>{t.gratis}</strong></p>
    <a class="boton" href={`${ruta("inicio", idioma)}#${idioma === "es" ? "descargas" : "downloads"}`}>{t.descargar}</a>
  </aside>
  <section class="relacionadas">
    <h2>{t.relacionadas}</h2>
    <ul>
      {
        a.relacionadas.map((p) => {
          const r = relacionada(p);
          return (
            <li>
              <a href={ruta(p, idioma)}>{r ? r.h1.replace(/\.$/, "") : ruta(p, idioma)}</a>
              {r && <span>{r.resumen}</span>}
            </li>
          );
        })
      }
    </ul>
  </section>
</Pagina>

<style>
  .destacado {
    display: grid;
    justify-items: center;
    gap: 4px;
    margin-top: 10px;
    padding: 18px 28px 20px;
    border-radius: var(--radio);
    background: color-mix(in srgb, var(--relleno) 16%, var(--lienzo));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--relleno) 55%, transparent);
  }
  .destacado strong {
    font-size: clamp(44px, 7vw, 64px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--tinta);
  }
  .destacado span {
    max-width: 30ch;
    color: var(--cuerpo);
    font-size: 15px;
  }
  .versus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-top: 10px;
  }
  .lado {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 22px;
    border-radius: 999px;
    background: var(--suave);
    box-shadow: inset 0 0 0 1px var(--filete);
    font-size: 20px;
    font-weight: 700;
    color: var(--tinta);
  }
  .lado.apolo {
    background: color-mix(in srgb, var(--relleno) 16%, var(--lienzo));
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--relleno) 55%, transparent);
  }
  .vs {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--apagado);
  }
  .fecha {
    color: var(--apagado);
    font-size: 14px;
  }
  .final {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    margin-top: 48px;
    padding: 20px 24px;
    border-radius: 18px;
    background: var(--suave);
    box-shadow: 0 0 0 1px var(--filete);
  }
  .final p {
    margin: 0;
  }
  .relacionadas ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 12px;
  }
  .relacionadas li {
    display: grid;
    align-content: start;
    gap: 6px;
    margin: 0;
    padding: 18px 20px;
    border-radius: var(--radio-chico);
    background: var(--suave);
    box-shadow: inset 0 0 0 1px var(--filete);
  }
  .relacionadas a {
    font-weight: 700;
    color: var(--tinta);
  }
  .relacionadas span {
    color: var(--apagado);
    font-size: 14px;
  }
</style>
