---
// Una página de secciones de texto (ADR 0033): la línea de comandos y los
// agentes. Las mismas piezas que las páginas de descarga, sin tarjeta.
import type { PaginaDescarga as Contenido } from "../contenido/descargar";
import type { Idioma, Pagina as P } from "../i18n/rutas";
import Pagina from "../layouts/Pagina.astro";
import Secciones from "./Secciones.astro";

interface Props {
  idioma: Idioma;
  pagina: P;
  c: Contenido;
}
const { idioma, pagina, c } = Astro.props;
---

<Pagina idioma={idioma} pagina={pagina} titulo={c.titulo} descripcion={c.descripcion} etiqueta={c.etiqueta} h1={c.h1} entrada={c.entrada}>
  <Secciones idioma={idioma} secciones={c.secciones} />
  <slot />
</Pagina>
