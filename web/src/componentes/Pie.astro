---
// El pie (ADR 0033), por columnas: descargas, usar, aprender y Apolo, con lo legal (el aviso legal, de
// webcafeina.com; la privacidad del programa y las cookies, de esta web).
import { textos } from "../i18n";
import { navegacion } from "../i18n/navegacion";
import { type Idioma, ruta } from "../i18n/rutas";

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);
const n = navegacion(idioma);
const COLUMNAS = [
  n.descargas,
  { titulo: n.usar.titulo, enlaces: [...n.usar.enlaces, n.novedades] },
  n.aprender,
];
---

<footer class="pie">
  <div class="envoltura">
    <div class="columnas">
      {
        COLUMNAS.map((c) => (
          <nav aria-label={c.titulo}>
            <p class="titulo">{c.titulo}</p>
            {c.enlaces.map((e) => <a href={e.href}>{e.texto}</a>)}
          </nav>
        ))
      }
      <nav aria-label={t.nav.apolo}>
        <p class="titulo">{t.nav.apolo}</p>
        <a href="https://github.com/webcafeina/Apolo" rel="noopener">GitHub</a>
        <a href={ruta("mapa", idioma)}>{t.pie.mapa}</a>
        <a href="https://webcafeina.com/aviso-legal/" rel="noopener">{t.pie.aviso}</a>
        <a href={ruta("privacidad", idioma)}>{t.pie.privacidad}</a>
        <a href={ruta("cookies", idioma)}>{t.pie.cookies}</a>
        <button type="button" class="preferencias" data-preferencias-cookies hidden>{t.cookies.preferencias}</button>
      </nav>
    </div>
    <div class="firma">
      <p>{t.pie.licencia}</p>
      <p>{t.pie.optimizadas}</p>
    </div>
  </div>
</footer>

<style>
  .pie {
    border-top: 1px solid var(--filete);
    padding-block: 48px calc(48px + env(safe-area-inset-bottom, 0px));
    font-size: 13px;
    color: var(--apagado);
  }
  .envoltura {
    display: grid;
    gap: 32px;
  }
  .columnas {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px 24px;
  }
  nav {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 10px;
    font-size: 15px;
  }
  .titulo {
    margin: 0 0 2px;
    font-weight: 800;
    color: var(--tinta);
  }
  nav a {
    color: var(--cuerpo);
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .preferencias {
    border: 0;
    background: none;
    padding: 0;
    color: var(--cuerpo);
    font-size: 15px;
    text-align: left;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }
  .preferencias[hidden] {
    display: none;
  }
  .firma {
    display: grid;
    gap: 6px;
  }
  .firma p {
    margin: 0;
  }
  @media (max-width: 720px) {
    .columnas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
