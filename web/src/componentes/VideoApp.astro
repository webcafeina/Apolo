---
// Apolo en marcha (ADR 0033): unos segundos en bucle, sin sonido, en la
// ventana del sistema de la vista (la de «En tu sistema») y en el idioma de la
// página. Solo se descarga y arranca el que se ve, al entrar en pantalla
// (web.ts), no con «reducir el movimiento», y tiene su botón de pausa (WCAG 2.2.2).
import { textos } from "../i18n";
import type { Idioma } from "../i18n/rutas";
import Ventana from "./Ventana.astro";

interface Props {
  idioma: Idioma;
}
const { idioma } = Astro.props;
const t = textos(idioma);
const VISTAS = ["macos", "windows", "gnome", "kde"] as const;
---

<section class="seccion alterna" aria-labelledby="video-titulo">
  <div class="envoltura">
    <div class="cabeza" data-aparece>
      <span class="etiqueta">{t.video.etiqueta}</span>
      <h2 id="video-titulo">{t.video.titulo}</h2>
    </div>
    <div data-aparece>
      {
        VISTAS.map((v) => (
          <div class="vista" data-vista={v}>
            <Ventana vista={v}>
              <div class="caja" data-video>
                <video muted loop playsinline preload="none" poster={`/video/${v}-${idioma}-poster.webp`} width="1600" height="1000" aria-label={t.video.titulo}>
                  <source src={`/video/${v}-${idioma}.mp4`} type="video/mp4" />
                </video>
                <button type="button" class="pausa" data-pausa={t.video.pausa} data-seguir={t.video.seguir} aria-label={t.video.seguir}>
                  <svg class="icono-seguir" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2.5v11l9-5.5z" fill="currentColor" /></svg>
                  <svg class="icono-pausa" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 2h3v12H4zM9 2h3v12H9z" fill="currentColor" /></svg>
                </button>
              </div>
            </Ventana>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .seccion {
    padding-block: clamp(72px, 10vw, 128px);
    background: var(--suave);
  }
  .cabeza {
    display: grid;
    justify-items: center;
    gap: 14px;
    max-width: 760px;
    margin: 0 auto 40px;
    text-align: center;
  }
  h2 {
    font-size: clamp(34px, 5vw, 60px);
    line-height: 1.04;
  }
  .caja {
    position: relative;
  }
  video {
    width: 100%;
    height: auto;
  }
  .pausa {
    position: absolute;
    left: 14px;
    bottom: 14px;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(20 20 24 / 0.72);
    color: #fff;
    cursor: pointer;
    display: grid;
    place-items: center;
  }
  .vista {
    display: none;
  }
  :global(html:not([data-vista])) .vista[data-vista="macos"],
  :global(html[data-vista="macos"]) .vista[data-vista="macos"],
  :global(html[data-vista="windows"]) .vista[data-vista="windows"],
  :global(html[data-vista="gnome"]) .vista[data-vista="gnome"],
  :global(html[data-vista="kde"]) .vista[data-vista="kde"] {
    display: block;
  }
  .icono-pausa,
  [data-reproduciendo] .icono-seguir {
    display: none;
  }
  [data-reproduciendo] .icono-pausa {
    display: block;
  }
</style>
