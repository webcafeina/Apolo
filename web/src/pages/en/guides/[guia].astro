---
// Una página por cada una (ADR 0034); la ruta sale de rutas.ts.
import PaginaArticulo from "../../../componentes/PaginaArticulo.astro";
import type { Articulo } from "../../../contenido/articulos";
import { GUIAS } from "../../../contenido/guias";
import { ruta } from "../../../i18n/rutas";

export function getStaticPaths() {
  return GUIAS.en.map((a) => ({ params: { guia: ruta(a.pagina, "en").split("/").at(-2) }, props: { a } }));
}
const { a } = Astro.props as { a: Articulo };
---

<PaginaArticulo idioma="en" a={a} />
